# =============================================================================
# MoneyGo Simulador — Variáveis de Ambiente
# Copie este arquivo para .env.local e preencha os valores reais
# NUNCA suba .env.local para o repositório
# =============================================================================

# ----- Marca (white-label / multimarca) -----
# Define a identidade ativa (logo, cores, textos, CNPJ, redes). Ver lib/brand/.
# Valores: moneygo (default) | capitamax
NEXT_PUBLIC_BRAND=moneygo

# ----- Supabase MoneyGo (auth do operador + tabela de propostas) -----
# Pegue em: Supabase Dashboard > Project Settings > API
# A "anon/publishable key" é pública (vai no browser). NÃO use a service_role key aqui.
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# ----- Supabase Capita Max (projeto/banco PRÓPRIO, isolado do MoneyGo) -----
# Usado só quando NEXT_PUBLIC_BRAND=capitamax (ver lib/brand/capitamax.ts).
# Sem fallback de propósito: se faltar, a marca falha ao conectar em vez de
# usar o banco do MoneyGo por engano. Em produção (deploy Netlify da Capita
# Max), configurar com estes MESMOS nomes de variável.
NEXT_PUBLIC_SUPABASE_URL_CAPITAMAX=https://SEU_PROJETO_CAPITAMAX.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY_CAPITAMAX=sb_publishable_xxx

# ----- Kommo CRM (integração primária de leads) -----
KOMMO_SUBDOMAIN=moneygo
KOMMO_LONG_LIVED_TOKEN=TODO_gere_em_Kommo_Integracoes_API
KOMMO_PIPELINE_ID=12887799
KOMMO_HOME_EQUITY_STAGE_ID=99376387   # TODO: verificar
KOMMO_AUTO_EQUITY_STAGE_ID=TODO_id_do_stage_auto_equity
KOMMO_FINANCIAMENTO_STAGE_ID=TODO_id_do_stage_financiamento_imobiliario
KOMMO_CONSTRUCAO_STAGE_ID=TODO_id_do_stage_credito_construcao

# ----- Google Sheets (fallback de leads, quando o Kommo falha) -----
# URL do Web App do Apps Script publicado ("Implantar > Nova implantação >
# App da Web", acesso "Qualquer pessoa"). Secreta: server-side, NUNCA NEXT_PUBLIC.
# Passo a passo em docs/integracao-crm.md. Vazio = fallback desativado.
GOOGLE_SHEETS_WEBHOOK_URL=

# ----- Consulta de placa (Auto Equity) -----
# Token do provedor API Placas (apiplacas.com.br). Server-side, NUNCA NEXT_PUBLIC.
# Sem este token, o funil cai automaticamente no preenchimento manual (FIPE grátis).
APIPLACAS_TOKEN=TODO_token_do_api_placas

# ----- Meta Pixel -----
NEXT_PUBLIC_META_PIXEL_ID=TODO_seu_pixel_id

# ----- Google Tag Manager -----
NEXT_PUBLIC_GTM_ID=TODO_GTM-XXXXXXX

# ----- URL base (para OG tags e canonicals) -----
NEXT_PUBLIC_BASE_URL=https://www.moneygosolucoesemcredito.com.br
